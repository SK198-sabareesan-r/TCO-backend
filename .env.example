# ============================================================
# AWS SECRETS MANAGER (Primary credential source)
# ============================================================
# Set this to have credentials loaded automatically from
# Secrets Manager. The secret must be a JSON object containing
# any of the keys below. Leave blank to skip Secrets Manager.
AWS_SECRET_NAME=cloud-migration-app/credentials

# Region where the secret lives (defaults to AWS_REGION)
# AWS_SECRET_REGION=us-east-1

# ============================================================
# AWS CREDENTIALS (Fallback when Secrets Manager is not used)
# ============================================================
# Option 1: SSO / named profile (recommended)
AWS_PROFILE=your-sso-profile-name

# Option 2: Explicit access keys (uncomment if not using a profile)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS Region
AWS_REGION=us-east-1

# Bedrock Model ID for Claude Sonnet 4.5
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250514-v1:0

# ============================================================
# POSTGRESQL DATABASE (RDS)
# ============================================================
DB_HOST=your-rds-hostname.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=aws_pricing
DB_USER=postgres
DB_PASSWORD=your-database-password

# ============================================================
# OPTIONAL
# ============================================================
ENABLE_CALCULATOR_LINKS=true
