  "mapping_fields": {
    "ec2": {
      "description": "Fields to consider when mapping GCP Compute Engine or Azure Virtual Machines to AWS EC2",
      "required_fields": [
        "region",
        "instance_type",
        "vcpu",
        "memory",
        "operating_system",
        "storage"
      ],
      "field_aliases": {
        "region": ["region", "location", "zone", "availability_zone", "regioncode"],
        "instance_type": ["instance_type", "instancetype", "machine_type", "vm_size", "size"],
        "vcpu": ["vcpu", "vcpus", "cpu", "cores", "core_count", "processor_count"],
        "memory": ["memory", "memory_gib", "ram", "memory_gb", "ram_gb"],
        "operating_system": ["operating_system", "os", "operatingsystem", "platform", "image"],
        "storage": ["storage", "disk", "ebs", "volume", "disk_size", "storage_amount"]
      }
    },
    "s3": {
      "description": "Fields to consider when mapping GCP Cloud Storage or Azure Blob Storage to AWS S3",
      "required_fields": [
        "region",
        "storage_class",
        "storage_amount"
      ],
      "field_aliases": {
        "region": ["region", "location", "zone", "regioncode"],
        "storage_class": ["storage_class", "storageclass", "tier", "access_tier", "storage_tier", "class", "sku"],
        "storage_amount": ["storage", "storage_amount", "size", "capacity", "storage_size", "data_size"]
      }
    },
    "rds": {
      "description": "Fields to consider when mapping GCP Cloud SQL/AlloyDB or Azure SQL Database to AWS RDS",
      "required_fields": [
        "database_engine",
        "region",
        "storage"
      ],
      "field_aliases": {
        "database_engine": ["database_engine", "databaseengine", "engine", "db_engine", "database_type", "db_type"],
        "region": ["region", "location", "zone", "regioncode"],
        "storage": ["storage", "disk", "storage_size", "disk_size", "capacity"]
      }
    },
    "vpc": {
      "description": "Fields to consider when mapping GCP VPC or Azure VNet to AWS VPC",
      "required_fields": [
        "vpc_type",
        "region"
      ],
      "field_aliases": {
        "vpc_type": ["vpc", "vpc_type", "network", "network_type", "vnet", "virtual_network"],
        "region": ["region", "location", "zone", "regioncode"]
      }
    },
    "lambda": {
      "description": "Fields to consider when mapping GCP Cloud Functions/Cloud Run or Azure Functions to AWS Lambda",
      "required_fields": [
        "free_tier",
        "compute_time",
        "runtime",
        "memory"
      ],
      "field_aliases": {
        "free_tier": ["free_tier", "freetier", "free", "tier", "pricing_tier"],
        "compute_time": ["compute_time", "computetime", "execution_time", "duration", "timeout", "runtime_duration"],
        "runtime": ["runtime", "language", "environment", "platform", "runtime_version"],
        "memory": ["memory", "memory_mb", "ram", "memory_size", "allocated_memory"]
      }
    }
  },
  
